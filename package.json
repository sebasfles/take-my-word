{
  "name": "take-my-word",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "pnpm -r lint && pnpm lint:workflows",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "lint:workflows": "github-actionlint",
    "release:desktop": "node apps/desktop/scripts/release.ts",
    "tf": "node packages/deployment/src/tf.ts",
    "selfhost": "node packages/deployment/src/selfhost.ts",
    "deploy:api": "node packages/deployment/src/deploy.ts api",
    "deploy:web": "node packages/deployment/src/deploy.ts web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-actionlint": "1.7.12",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
