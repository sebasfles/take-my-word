{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "src/app/.well-known/**/*.ts",
    "scripts",
    "e2e",
    "integration",
    "*.config.ts",
    ".next/types/**/*.ts"
  ]
}
