{
  "name": "@take-my-word/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bundle": "open-next build",
    "lint": "eslint . && prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --ignore-path .gitignore .",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "integration": "vitest run --config vitest.integration.config.ts --no-file-parallelism",
    "e2e": "playwright test --workers=1",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1154.0",
    "@take-my-word/cognito": "workspace:*",
    "@take-my-word/shared": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1154.0",
    "@aws-sdk/client-dynamodb": "3.1154.0",
    "@aws-sdk/lib-dynamodb": "3.1154.0",
    "@opennextjs/aws": "4.1.10",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
