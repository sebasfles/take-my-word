{
  "name": "@take-my-word/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint . && prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "token": "node scripts/token.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts --no-file-parallelism",
    "eval:context": "node evaluation/user-context.ts",
    "eval:transcription": "node evaluation/transcription.ts",
    "eval:e2e": "node evaluation/end-to-end.ts",
    "eval:cleanup": "node evaluation/cleanup.ts",
    "eval:capture": "node evaluation/capture-raws.ts",
    "eval:summary": "node evaluation/summary.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1154.0",
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/client-secrets-manager": "3.1154.0",
    "@aws-sdk/lib-dynamodb": "3.1154.0",
    "@hono/aws-lambda": "1.0.0",
    "@take-my-word/shared": "workspace:*",
    "aws-jwt-verify": "5.2.1",
    "busboy": "1.6.0",
    "hono": "4.13.13",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1154.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1154.0",
    "@aws-sdk/client-lambda": "3.1154.0",
    "@aws-sdk/client-polly": "3.1154.0",
    "@aws-sdk/client-sts": "3.1154.0",
    "@take-my-word/cognito": "workspace:*",
    "@take-my-word/deployment": "workspace:*",
    "@types/aws-lambda": "8.10.164",
    "@types/busboy": "1.5.5",
    "esbuild": "0.28.2"
  }
}
