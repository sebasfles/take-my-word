{
  "name": "@take-my-word/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "lint": "eslint . && prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --ignore-path .prettierignore .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "tauri": "tauri",
    "windows:prepare": "scripts/windows.sh pnpm install --frozen-lockfile && scripts/windows.sh pnpm build",
    "rust:lint": "scripts/windows.sh cargo fmt --check && pnpm windows:prepare && scripts/windows.sh cargo clippy --all-targets --locked -- -D warnings && scripts/windows.sh cargo clippy --release --features dev --locked -- -D warnings",
    "rust:test": "pnpm windows:prepare && scripts/windows.sh cargo test --locked -- --test-threads=1",
    "windows:build": "pnpm windows:prepare && scripts/windows.sh pnpm tauri:build:dev",
    "screenshots": "node screenshots/capture.ts",
    "contract": "node contract/write.ts",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "tauri:build:prd": "tauri build --config src-tauri/tauri.prd.conf.json",
    "check:version": "node scripts/version.ts"
  },
  "dependencies": {
    "@take-my-word/brand": "workspace:*",
    "@take-my-word/shared": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
