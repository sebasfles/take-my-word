{
  "dictationMeta": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "locale": {
        "type": "string",
        "pattern": "^(es|en)(-[A-Z]{2})?$"
      },
      "styleId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "appId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "language": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      }
    }
  },
  "dictationResponse": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "raw": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "skipped": {
        "type": "string",
        "const": "silence"
      },
      "styleId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "providers": {
        "type": "object",
        "properties": {
          "transcriber": {
            "type": "string"
          },
          "refiner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "latencyMs": {
        "type": "object",
        "properties": {
          "quota": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "profile": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transcribe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "refine": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "save": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "total"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "raw",
      "text",
      "providers",
      "latencyMs"
    ],
    "additionalProperties": false
  },
  "segmentMeta": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      }
    }
  },
  "segmentResponse": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "raw": {
        "type": "string"
      },
      "skipped": {
        "type": "string",
        "const": "silence"
      },
      "language": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      },
      "receipt": {
        "type": "string"
      },
      "providers": {
        "type": "object",
        "properties": {
          "transcriber": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "latencyMs": {
        "type": "object",
        "properties": {
          "quota": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "profile": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transcribe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "total"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "raw",
      "providers",
      "latencyMs"
    ],
    "additionalProperties": false
  },
  "earlierSegments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "minItems": 1,
    "maxItems": 24,
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "text",
        "receipt"
      ],
      "additionalProperties": false
    }
  },
  "apiError": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "conflict",
              "payload_too_large",
              "unsupported_media_type",
              "quota_exceeded",
              "provider_failed",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "error"
    ],
    "additionalProperties": false
  },
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "defaultStyleId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "locale": {
        "type": "string",
        "pattern": "^(es|en)(-[A-Z]{2})?$"
      },
      "dictationLanguages": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ]
        }
      },
      "context": {
        "type": "object",
        "properties": {
          "picks": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "software-development",
                "data-ai",
                "design",
                "product-management",
                "marketing",
                "sales",
                "customer-support",
                "writing-content",
                "research-academia",
                "biology-life-sciences",
                "medicine-health",
                "law",
                "finance-accounting",
                "education-teaching",
                "engineering",
                "student"
              ]
            }
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "picks",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "defaultStyleId",
      "locale",
      "dictationLanguages",
      "context"
    ],
    "additionalProperties": false
  },
  "styleList": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "styles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "name": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "builtin": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "prompt",
            "builtin"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "styles"
    ],
    "additionalProperties": false
  },
  "appRuleList": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "appId": {
              "type": "string"
            },
            "styleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "keystroke": {
              "type": "string",
              "enum": [
                "ctrl+v",
                "ctrl+shift+v",
                "shift+insert",
                "cmd+v"
              ]
            }
          },
          "required": [
            "id",
            "appId",
            "keystroke"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "rules"
    ],
    "additionalProperties": false
  },
  "discovery": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "apiUrl": {
        "type": "string"
      },
      "region": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[a-z]+)+-\\d{1,2}$"
      },
      "userPoolId": {
        "type": "string",
        "pattern": "^([a-z]{2}(-[a-z]+)+-\\d{1,2})_[A-Za-z0-9]{1,55}$"
      },
      "clientId": {
        "type": "string",
        "pattern": "^[a-z0-9]{1,128}$"
      }
    },
    "required": [
      "version",
      "apiUrl",
      "region",
      "userPoolId",
      "clientId"
    ],
    "additionalProperties": false
  }
}
