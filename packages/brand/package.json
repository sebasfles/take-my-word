    "@testing-library/user-event": "14.6.8",
    "@types/fontkit": "2.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fontkit": "2.0.4",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "subset-font": "2.9.0"
  }
