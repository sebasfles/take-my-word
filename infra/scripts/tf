#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: infra/scripts/tf <core|dev|prd> <terraform args...>" >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
env_dir="$root/infra/environments/$1"
shift

[ -d "$env_dir" ] || { echo "no environment at $env_dir" >&2; exit 2; }
[ -f "$root/.env" ] || { echo "missing $root/.env" >&2; exit 2; }

TF_VAR_github_app_pem="$(python3 -I - "$root/.env" <<'PY'
import sys
for line in open(sys.argv[1], encoding="utf-8"):
    key, sep, value = line.rstrip("\n").partition("=")
    if sep and key.strip() == "GITHUB_APP_PEM":
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        sys.stdout.write(value.replace("\\n", "\n"))
        break
else:
    sys.exit("GITHUB_APP_PEM is missing from .env")
PY
)"
export TF_VAR_github_app_pem
export AWS_PROFILE="${AWS_PROFILE:-fless-takemyword}"

exec terraform -chdir="$env_dir" "$@"
